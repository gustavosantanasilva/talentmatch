# ---------------------------------------------------------------------------
# TalentMatch — arquivos ignorados pelo Git
# ---------------------------------------------------------------------------

# Segredos e configuração local (NUNCA versionar)
.env
.env.*
!.env.example
app/config/database.local.php
app/config/ai.local.php

# Logs e cache em tempo de execução
storage/logs/*
!storage/logs/.gitkeep
storage/cache/*
!storage/cache/.gitkeep

# Dependências e artefatos
/vendor/
node_modules/
*.log

# Sistema operacional e editores
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Banco de dados local
*.sqlite
*.sqlite3
dump*.sql

# Build / temporários
/tmp/
*.bak
