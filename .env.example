# ---------------------------------------------------------------------------
# TalentMatch — modelo de variáveis de ambiente
# Copie este arquivo para ".env" e preencha os valores reais.
# O arquivo ".env" fica FORA da raiz pública e nunca deve ser versionado.
# ---------------------------------------------------------------------------

# Aplicação
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo
APP_SESSION_NAME=talentmatch_session

# Banco de dados MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=talentmatch
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Inteligência artificial (DeepSeek)
# A chave fica exclusivamente no servidor. Nunca exponha no frontend.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT=30
DEEPSEEK_MAX_TOKENS=2400
